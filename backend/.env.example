# ---------------------------------------------------------------------------
# AutoBI backend configuration. Copy to `.env` and edit.
# Every value has a working default; the app runs with no .env at all.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- AI provider -----------------------------------------------------------
# AI is OPTIONAL. With AI_PROVIDER=none the product is fully functional and
# generates KPIs, charts and insights from deterministic rules.
#
# AI_PROVIDER: anthropic | openai | none
AI_PROVIDER=none

# Anthropic example:
#   AI_PROVIDER=anthropic
#   AI_MODEL=claude-sonnet-5
#   AI_API_KEY=sk-ant-...
#
# OpenAI (or any OpenAI-compatible endpoint) example:
#   AI_PROVIDER=openai
#   AI_MODEL=gpt-4o-mini
#   AI_API_KEY=sk-...
#   AI_BASE_URL=https://api.openai.com/v1

AI_MODEL=claude-sonnet-5
AI_API_KEY=
AI_BASE_URL=
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_ENABLED=true

# --- storage ---------------------------------------------------------------
STORAGE_BACKEND=local
RETENTION_HOURS=24

# --- limits ----------------------------------------------------------------
MAX_UPLOAD_BYTES=104857600
MAX_ROWS_ANALYZED=1000000

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Supabase (only when STORAGE_BACKEND=supabase) --------------------------
# Files (raw CSV, cleaned Parquet) go to Supabase Storage; dataset metadata,
# analysis artifacts and saved dashboards go to Postgres (via PostgREST).
# Run supabase/schema.sql once, then set:
#   STORAGE_BACKEND=supabase
#   SUPABASE_URL=https://<project-ref>.supabase.co
#   SUPABASE_SERVICE_KEY=<service-role key — server-side only, never the anon key>
#   SUPABASE_BUCKET=autobi
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=autobi
